FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    box
    {
        type fixedValue;
        value uniform 10;
    }

    channels
    {
        type fixedValue;
        value uniform 0;
    }

    inlet
    {
        type zeroGradient;
    }

    outlet
    {
        type zeroGradient;
    }
}
